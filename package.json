{
  "name": "chopim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test src/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e playwright.config.js index.html package.json README.md",
